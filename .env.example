# Meta Model API. Official name is MODEL_API_KEY.
# Server-side only. Never commit a real value. Never expose to the browser bundle.
MODEL_API_KEY=

# Alias used if MODEL_API_KEY is unset (this repo reads MODEL_API_KEY ?? META_API_KEY).
META_API_KEY=

# Baseten hosted Muse Spark Open. Server-side only.
BASETEN_API_KEY=
